# ==============================================================================
# FraudGuard AI Service - Environment Configuration Template
# Copy this file to .env and configure values before starting the service.
# ==============================================================================

# Internal shared secret for service-to-service communication (Spring Boot <-> AI Service).
# All requests to protected endpoints (/analyze-claim, /verify-document, /inspect-photo)
# must provide this in the 'X-Internal-Key' header.
# REQUIRED in production. Leave empty ONLY if AUTH_DISABLED=true.
AI_INTERNAL_KEY=your-secure-internal-secret-token-here

# Set to 'true' only in local development to bypass internal key verification.
# In production, must be false (or omitted) to fail closed.
AUTH_DISABLED=false

# Port on which the FastAPI application listens
PORT=8000

# Server host (0.0.0.0 for containerized deployment)
HOST=0.0.0.0
